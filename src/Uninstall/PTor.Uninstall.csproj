<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Uninstall</AssemblyName>
    <!-- Uninstaller always runs elevated: HKLM service/DNS cleanup needs it. -->
    <ApplicationManifest>..\app.admin.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Shared with the main app: same restore/audit logic, one implementation. -->
  <ItemGroup>
    <Compile Include="..\SystemProxyManager.cs" />
    <Compile Include="..\UserEnvManager.cs" />
    <Compile Include="..\SystemDnsManager.cs" />
    <Compile Include="..\AdminHelper.cs" />
    <Compile Include="..\DivertNative.cs" />
    <Compile Include="..\EnforcementCheckpoint.cs" />
  </ItemGroup>

</Project>
