<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Identity shown by Explorer / SmartScreen / AV vendors. Blank
         publisher metadata is a (small) trust negative — fill it in, and
         overwrite with your legal entity before buying a cert. -->
    <AssemblyCompany>PTor</AssemblyCompany>
    <AssemblyProduct>PTor — Tor Traffic Router</AssemblyProduct>
    <AssemblyDescription>Routes this Windows user's apps through Tor (system proxy, env vars, optional Tor-only packet lockdown).</AssemblyDescription>
    <AssemblyCopyright>Copyright © PTor contributors</AssemblyCopyright>
    <!-- English-only UI (no .resx anywhere): don't bundle the framework's
         satellite resource DLLs for ~20 other cultures into the single-file
         exe. Framework exception text stays English too — fine, our UI is. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Portable PDBs, separate file (PTor.pdb ~250KB), never embedded in
         the exe. Kept on purpose: line numbers in field crash reports are
         worth 0.4% of download size on a security tool. (Uninstall uses
         none — its *native* PDB was 13MB, different calculus.) -->
    <DebugType>portable</DebugType>
  </PropertyGroup>
<PropertyGroup>
  <!-- Debug runs unelevated for a smooth F5; Release (incl. publish) requires admin for WinDivert lockdown. -->
  <ApplicationManifest Condition="'$(Configuration)' == 'Release'">app.admin.manifest</ApplicationManifest>
  <ApplicationManifest Condition="'$(Configuration)' != 'Release'">app.manifest</ApplicationManifest>
</PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>
  <!-- The Uninstall companion is its own project: never compile it into the app. -->
  <ItemGroup>
    <Compile Remove="Uninstall\**" />
  </ItemGroup>
  <!-- WinDivert driver+DLL ride along with the build (arch subfolders). -->
  <ItemGroup>
    <Content Include="tools\WinDivert\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Tor bundle essentials for a working release (exe, transports, GeoIP).
         Cached consensus junk (cached-*, lock, state) is deliberately excluded. -->
    <Content Include="tools\tor\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tools\data\geoip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tools\data\geoip6">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tools\SmokeTest-Dns.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="rescue-internet.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="fix-internet-now.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="kill-windivert.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="clear-startup.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
